{
  "name": "arbur-cpa-marketing-website",
  "version": "1.0.0",
  "private": true,
  "description": "Arbur CPA: marketing site and task backlog, as npm workspaces",
  "workspaces": [
    "site",
    "backlog"
  ],
  "scripts": {
    "start": "npm start -w site",
    "build": "npm run build -w site",
    "test": "npm test -w site",
    "test:live": "npm run test:live -w site",
    "screenshots": "npm run screenshots -w site",
    "backlog": "npm exec -w backlog -- backlog",
    "prepare": "git config core.hooksPath .githooks || true"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/arwa-cpa/marketing-website.git"
  }
}
