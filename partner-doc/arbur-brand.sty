% Arbur CPA brand layer for the partner flyer: page, colors, fonts and the
% building blocks partner-services.tex uses. Content lives in that file;
% this one only decides how it looks.
\NeedsTeXFormat{LaTeX2e}
\ProvidesPackage{arbur-brand}[2026/11/21 Arbur CPA brand styles]

% ---- Page --------------------------------------------------------------
% The top margin ends at the header; \flyerheader adds the hero's height
% below it. The bottom margin leaves room for the footer band.
\RequirePackage[letterpaper, top=1.15in, bottom=1.25in, left=0.6in, right=0.6in]{geometry}
\pagestyle{empty}
\setlength{\parindent}{0pt}
\setlength{\parskip}{0pt}

% ---- Colors: the same as the site's (site/src/css/styles.css) -----------
% Like the site, the page reads like a tree: a hint of green leaves at the top
% (the hero), warming to brown roots at the bottom (the footer).
\RequirePackage{xcolor}
\definecolor{bgcream}{HTML}{F6F4F1}
\definecolor{bgtaupe}{HTML}{E6DED6}
\definecolor{accenttan}{HTML}{D3C3A6}
\definecolor{sage}{HTML}{738063}
\definecolor{darkgreen}{HTML}{20322E}
\definecolor{bgleaf}{HTML}{EDF0E6}
\definecolor{bgroot}{HTML}{3A2A1E}
\definecolor{textbody}{HTML}{2B332F}
\definecolor{textmuted}{HTML}{5C655F}
\definecolor{footertext}{HTML}{D8CCBF}

% ---- Fonts: Cormorant Garamond headings, Roboto body ------------------
% Both come from CTAN; Tectonic downloads them on the first build. Weights
% match the site: Roboto 400 body with 500 for bold, Cormorant 600 headings.
\RequirePackage{fontspec}
\setmainfont{Roboto}[
  Extension      = .otf,
  UprightFont    = *-Regular,
  BoldFont       = *-Medium,
  ItalicFont     = *-Italic,
  BoldItalicFont = *-MediumItalic,
]
\newfontfamily\headingfont{CormorantGaramond}[
  Extension      = .ttf,
  UprightFont    = *-SemiBold,
  BoldFont       = *-Bold,
  ItalicFont     = *-SemiBoldItalic,
  BoldItalicFont = *-BoldItalic,
]
\color{textbody}

% ---- Graphics, tables, lists --------------------------------------------
\RequirePackage{graphicx}
\graphicspath{{assets/}}
\RequirePackage{tikz}
\RequirePackage{eso-pic}
\RequirePackage{tabularx}
\RequirePackage{array}
\RequirePackage{colortbl}
\RequirePackage{enumitem}
\RequirePackage{soul}
\RequirePackage[hidelinks]{hyperref}

% ---- Unconfirmed content -------------------------------------------------
% \tbd{text} marks anything Arwa still has to confirm: it prints on a tan
% highlight, and while any \tbd remains the page carries a DRAFT watermark.
% The flyer is one page, so every \tbd is typeset before the page ships out.
% The highlight is soul's \hl, so long notes wrap across lines.
\newif\ifarbur@draft
\sethlcolor{accenttan}
\newcommand{\tbd}[1]{%
  \global\arbur@drafttrue
  {\color{textbody}\hl{#1}}%
}
\AddToShipoutPictureBG{%
  \ifarbur@draft
    \AtPageCenter{%
      \makebox[0pt]{\rotatebox{40}{%
        \fontsize{150}{150}\selectfont\headingfont\bfseries
        \textcolor{accenttan!35}{DRAFT}}}}%
  \fi
}

% ---- Top of the page: top bar, header and hero -------------------------
% \flyerheader{top bar text}{header label}{eyebrow}{title}{intro}, like the
% top of the site: a dark-green bar, a white header with the sage mark and
% name, and a leaf-green hero. The hero is measured, so the band fits its
% text and the body starts just below it.
\newsavebox{\arbur@hero}
\newlength{\arbur@herobottom}
\newcommand{\flyerheader}[5]{%
  \sbox{\arbur@hero}{\parbox[t]{\linewidth}{%
    {\fontsize{8.5}{10}\selectfont\color{sage}\addfontfeature{LetterSpace=15}\MakeUppercase{#3}}\par\vspace{8pt}
    {\headingfont\fontsize{32}{34}\selectfont\color{darkgreen}#4\par}\vspace{9pt}
    {\fontsize{11.5}{16.5}\selectfont\color{textmuted}#5\par}}}%
  \setlength{\arbur@herobottom}{\dimexpr 1.15in + 0.62in + \ht\arbur@hero + \dp\arbur@hero\relax}%
  \AddToShipoutPictureBG*{%
    \begin{tikzpicture}[remember picture, overlay]
      \fill[darkgreen] (current page.north west) rectangle ([yshift=-0.3in]current page.north east);
      \node[text=bgtaupe, inner sep=0pt] at ([yshift=-0.15in]current page.north)
        {\fontsize{8.5}{10}\selectfont #1};
      \fill[bgtaupe] ([yshift=-1.14in]current page.north west) rectangle ([yshift=-1.15in]current page.north east);
      \node[anchor=west, inner sep=0pt] at ([xshift=0.6in, yshift=-0.725in]current page.north west)
        {\includegraphics[height=0.42in]{logo-mark-sage.png}\hspace{7pt}%
         \raisebox{0.1in}{\headingfont\fontsize{21}{21}\selectfont\color{sage}Arbur CPA}};
      \node[anchor=east, inner sep=0pt, text=darkgreen] at ([xshift=-0.6in, yshift=-0.725in]current page.north east)
        {\fontsize{8.5}{10}\selectfont\addfontfeature{LetterSpace=15}\MakeUppercase{#2}};
      \fill[bgleaf] ([yshift=-1.15in]current page.north west) rectangle ([yshift=-\arbur@herobottom]current page.north east);
      \node[anchor=north west, inner sep=0pt] at ([xshift=0.6in, yshift=-1.5in]current page.north west)
        {\usebox{\arbur@hero}};
    \end{tikzpicture}%
  }%
  \vspace*{\dimexpr 0.62in + \ht\arbur@hero + \dp\arbur@hero + 0.05in\relax}%
}

% ---- Section headings: small uppercase eyebrow + Cormorant title --------
\newcommand{\eyebrow}[1]{%
  {\fontsize{8}{10}\selectfont\color{sage}\addfontfeature{LetterSpace=18}\MakeUppercase{#1}}\par\vspace{2pt}}
\newcommand{\flyersection}[2]{%
  \par\vspace{14pt}\eyebrow{#1}%
  {\headingfont\fontsize{19}{21}\selectfont\color{darkgreen}#2\par}\vspace{6pt}}

% ---- Services and pricing table -----------------------------------------
% \begin{services} ... \service{name}{what's included}{price} ... \end{services}
\newcolumntype{Y}{>{\raggedright\arraybackslash}X}
\newcommand{\service}[3]{%
  % \leavevmode first: a color change at the very start of a cell adds a blank line
  \leavevmode{\headingfont\fontsize{12.5}{14}\selectfont\bfseries\color{darkgreen}#1} &
  \leavevmode{\color{textmuted}#2} & \raggedleft\leavevmode#3 \tabularnewline[3pt]
  \arrayrulecolor{bgtaupe}\hline\noalign{\vspace{3pt}}}
\newenvironment{services}{%
  \fontsize{9.5}{12.5}\selectfont
  \renewcommand{\arraystretch}{1.15}%
  \setlength{\tabcolsep}{5pt}%
  \tabularx{\linewidth}{@{}>{\raggedright\arraybackslash}p{1.95in} Y >{\raggedleft\arraybackslash}p{0.95in}@{}}
    {\fontsize{7.5}{9}\selectfont\color{sage}\addfontfeature{LetterSpace=12}SERVICE} &
    {\fontsize{7.5}{9}\selectfont\color{sage}\addfontfeature{LetterSpace=12}WHAT'S INCLUDED} &
    {\fontsize{7.5}{9}\selectfont\color{sage}\addfontfeature{LetterSpace=12}PRICE}\tabularnewline[2pt]
    \arrayrulecolor{sage}\hline\noalign{\vspace{4pt}}%
}{\endtabularx}

% ---- "How it works" numbered steps ---------------------------------------
\newlist{steps}{enumerate}{1}
\setlist[steps]{
  label={\headingfont\bfseries\fontsize{15}{15}\selectfont\color{sage}\arabic*},
  font=\color{textbody},
  leftmargin=22pt, labelsep=8pt, itemsep=4pt, topsep=0pt,
  before={\fontsize{9.5}{12.5}\selectfont},
}

% ---- Footer band ------------------------------------------------------------
% \flyerfooter{heading}{contact line}: a root-brown band across the bottom of
% the page, like the site's footer, with the white mark and name on the left.
% Set into a box now, so a \tbd in it counts towards the DRAFT watermark.
\newsavebox{\arbur@footer}
\newcommand{\flyerfooter}[2]{%
  \sbox{\arbur@footer}{\begin{tabular}{@{}r@{}}
    {\headingfont\fontsize{17}{19}\selectfont\color{bgcream}#1}\\[3pt]
    {\fontsize{9.5}{12}\selectfont\color{footertext}#2}
  \end{tabular}}%
  \AddToShipoutPictureBG*{%
    \begin{tikzpicture}[remember picture, overlay]
      \fill[bgroot] ([yshift=0.95in]current page.south west) rectangle (current page.south east);
      \node[anchor=west, inner sep=0pt] at ([xshift=0.6in, yshift=0.475in]current page.south west)
        {\includegraphics[height=0.4in]{logo-mark-white.png}\hspace{7pt}%
         \raisebox{0.09in}{\headingfont\fontsize{19}{19}\selectfont\color{bgcream}Arbur CPA}};
      \node[anchor=east, inner sep=0pt] at ([xshift=-0.6in, yshift=0.475in]current page.south east)
        {\usebox{\arbur@footer}};
    \end{tikzpicture}%
  }%
}
\newcommand{\contactsep}{\quad{\color{accenttan}\textbullet}\quad}
