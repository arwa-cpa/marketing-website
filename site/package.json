{
  "name": "arbur-cpa-site",
  "version": "1.0.0",
  "private": true,
  "description": "Arbur CPA marketing site, built with Eleventy",
  "type": "module",
  "scripts": {
    "start": "eleventy --serve",
    "build": "eleventy",
    "test": "playwright test --project=site",
    "test:live": "playwright test --project=live",
    "screenshots": "node scripts/screenshots.mjs",
    "pretest": "npm run browsers --silent",
    "prescreenshots": "npm run browsers --silent",
    "browsers": "PLAYWRIGHT_BROWSERS_PATH=0 playwright install --only-shell chromium"
  },
  "devDependencies": {
    "@11ty/eleventy": "^3.1.8",
    "@playwright/test": "^1.65.0"
  }
}
