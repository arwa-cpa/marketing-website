    <section class="services" id="services">
      <div class="wrap">
        <div class="section-head">
          <div>
            <p class="eyebrow">Services</p>
            <h2>When success makes things complicated</h2>
            <p class="subtitle">A life across the border, a growing business, rental properties or investments: success can turn simple finances into complicated ones. We make them understandable.</p>
          </div>
          <a class="btn btn-primary" href="/#book">Book a consultation</a>
        </div>

        <div class="service-layout">
          <article class="card">
            <ul class="service-list">
              <li>
                <span class="service-icon" aria-hidden="true">
                  <svg viewBox="0 0 24 24" width="28" height="28"><path fill="currentColor" d="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm-1 17.93c-3.95-.49-7-3.85-7-7.93 0-.62.08-1.21.21-1.79L9 15v1c0 1.1.9 2 2 2v1.93zm6.9-2.54c-.26-.81-1-1.39-1.9-1.39h-1v-3c0-.55-.45-1-1-1H8v-2h2c.55 0 1-.45 1-1V7h2c1.1 0 2-.9 2-2v-.41c2.93 1.19 5 4.06 5 7.41 0 2.08-.8 3.97-2.1 5.39z"/></svg>
                </span>
                U.S.&ndash;Canada cross-border tax
              </li>
              <li>
                <span class="service-icon" aria-hidden="true">
                  <svg viewBox="0 0 24 24" width="28" height="28"><path fill="currentColor" d="M16 11a3 3 0 1 0 0-6 3 3 0 0 0 0 6zm-8 0a3 3 0 1 0 0-6 3 3 0 0 0 0 6zm0 2c-2.33 0-7 1.17-7 3.5V19h14v-2.5c0-2.33-4.67-3.5-7-3.5zm8 0c-.29 0-.62.02-.97.05 1.16.84 1.97 1.97 1.97 3.45V19h6v-2.5c0-2.33-4.67-3.5-7-3.5z"/></svg>
                </span>
                Individual &amp; family tax preparation
              </li>
              <li>
                <span class="service-icon" aria-hidden="true">
                  <svg viewBox="0 0 24 24" width="28" height="28"><path fill="currentColor" d="M3 7l9-4 9 4v2H3zm1 3h16v9H4zm3 2v5h2v-5zm4 0v5h2v-5zm4 0v5h2v-5z"/></svg>
                </span>
                Business tax preparation
              </li>
              <li>
                <span class="service-icon" aria-hidden="true">
                  <svg viewBox="0 0 24 24" width="28" height="28"><path fill="currentColor" d="M19 3H5a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2V5a2 2 0 0 0-2-2zM9 17H7v-7h2zm4 0h-2V7h2zm4 0h-2v-4h2z"/></svg>
                </span>
                Year-round accounting support
              </li>
            </ul>
          </article>
          {%- for testimonial in testimonials | selectattr("excerpt") %}
          <figure class="service-quote">
            <blockquote>{{ testimonial.excerpt }}</blockquote>
            <figcaption>{{ testimonial.name }}</figcaption>
          </figure>
          {%- endfor %}
        </div>
      </div>
    </section>
