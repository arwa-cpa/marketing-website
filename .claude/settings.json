{
  "enabledPlugins": {
    "frontend-design@claude-plugins-official": true
  },
  "permissions": {
    "allow": [
      "Bash(npm start)",
      "Bash(npm run build)",
      "Bash(npm test)",
      "Bash(npm run screenshots)",
      "Bash(npm install)",
      "Bash(npm ci)",
      "Bash(git status*)",
      "Bash(git diff*)",
      "Bash(git log*)",
      "Bash(git show*)"
    ]
  },
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "[ -s \"$HOME/.nvm/nvm.sh\" ] && echo 'source \"$HOME/.nvm/nvm.sh\" && nvm use --silent >/dev/null' >> \"$CLAUDE_ENV_FILE\" || true"
          }
        ]
      }
    ]
  }
}
