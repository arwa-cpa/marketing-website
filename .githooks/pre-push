#!/usr/bin/env bash
# Runs the browser tests before every push; a failure cancels the push.
# Enabled by `npm install` (the "prepare" script sets core.hooksPath).
# Skip once with: git push --no-verify
set -euo pipefail

cd "$(git rev-parse --show-toplevel)"

# Git hooks don't get an interactive shell, so activate the .nvmrc Node version
if [ -s "$HOME/.nvm/nvm.sh" ]; then
  source "$HOME/.nvm/nvm.sh"
  nvm use --silent >/dev/null
fi

# Own server on its own port, so a running `npm start` (8080) is left alone.
port=8282
if curl -s -o /dev/null "http://localhost:$port/"; then
  echo "pre-push: something is already running on port $port; stop it and push again" >&2
  exit 1
fi

# The first -- passes the flags to the top-level start script, the second on
# to Eleventy. npm forwards the stop signal down to Eleventy, so killing the
# outer npm stops the server.
log=$(mktemp)
npm start --silent -- -- --quiet --port=$port >"$log" 2>&1 &
server=$!
trap 'kill $server 2>/dev/null; rm -f "$log"' EXIT

up=false
for _ in $(seq 1 60); do
  if curl -s -o /dev/null "http://localhost:$port/"; then up=true; break; fi
  kill -0 $server 2>/dev/null || break   # the server exited, no point waiting
  sleep 1
done

if [ "$up" != true ]; then
  echo "pre-push: the test server didn't start; its output:" >&2
  cat "$log" >&2
  echo "pre-push: (if a package is missing, run npm install)" >&2
  exit 1
fi

echo "pre-push: running browser tests (skip with git push --no-verify)"
BASE_URL="http://localhost:$port/" npm test --silent
